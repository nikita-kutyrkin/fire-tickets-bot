# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Токен Travelpayouts API (см. README.md, раздел «Как получить токен Travelpayouts»)
TRAVELPAYOUTS_TOKEN=

# Партнёрский маркер Travelpayouts (необязательно, нужен для комиссии с покупок)
TRAVELPAYOUTS_MARKER=

# ---- Значения по умолчанию для новых пользователей (дальше каждый меняет свои в /settings) ----

# IATA-код города вылета: LED — Санкт-Петербург, MOW — Москва, KZN — Казань и т.д.
ORIGIN=LED

# Билет считается горящим, если он дешевле обычной цены маршрута на столько процентов
# (обычная цена — медиана самых дешёвых билетов по дням на месяц вперёд)
MIN_DISCOUNT_PERCENT=40

# Потолок цены в рублях: дороже не присылать, даже если скидка большая. 0 — без потолка.
# Если обычную цену маршрута узнать не удалось, присылаются все билеты дешевле MAX_PRICE.
MAX_PRICE=3500

# Сколько дней вперёд смотреть: 0 — только сегодня, 1 — сегодня и завтра
DAYS_AHEAD=1

# Как часто проверять цены, в минутах
CHECK_INTERVAL_MINUTES=20

# Часовой пояс для «сегодня» и «завтра»
TIMEZONE=Europe/Moscow
